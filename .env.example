# SvelteKit 标准变量；本地开发一般无需配置。
# 若部署后出现 origin 相关报错，设为站点完整 URL，例如 https://example.com
ORIGIN=""

# 构建 GitHub Pages 静态版时设为 pages（通常仅在 CI 或本地验证 Pages 构建时使用）。
# 不设则默认构建 Vercel 版。
# CHRONOS_DEPLOY_TARGET=pages

# 同源多实例部署使用不同根路径，各路径的数据互相隔离；留空字符串表示根目录。
# CHRONOS_BASE_PATH="/chronos-one"

# Firebase Analytics Web 客户端配置。均为公开 Firebase 应用配置，不是服务账号密钥。
# 留空时 Web 构建不启用统计；Android 使用 apps/mobile/android/app/google-services.json。
PUBLIC_FIREBASE_API_KEY=""
PUBLIC_FIREBASE_APP_ID=""
PUBLIC_FIREBASE_AUTH_DOMAIN=""
PUBLIC_FIREBASE_MEASUREMENT_ID=""
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
PUBLIC_FIREBASE_PROJECT_ID=""
PUBLIC_FIREBASE_STORAGE_BUCKET=""

# 移动端分享链接的公开网页导入地址，须包含 /s 路径；留空时分享口令而非本机 WebView 链接。
# PUBLIC_CHRONOS_SHARE_IMPORT_URL="https://example.com/s"

# 官方插件市场的发行目录根地址；默认 https://ue-dnd.github.io/Chronos/plugins/releases/
# 构建时自动追加宿主版本与 /catalog.json。仅接受无查询参数的 HTTPS 目录地址。
# 开发环境始终使用本地市场与 HMR，不使用此远程地址。
# CHRONOS_PLUGIN_MARKET_BASE_URL="https://example.com/plugins/releases/"

# Android 官方就绪发布 feed，与网站当前部署版本无关。
# PUBLIC_ANDROID_RELEASE_FEED_URL="https://ue-dnd.github.io/Chronos/android/stable.json"
# iOS 自签 IPA 的就绪 feed。应用只下载并校验安装包，不能在应用内覆盖安装。
# PUBLIC_IOS_RELEASE_FEED_URL="https://ue-dnd.github.io/Chronos/ios/stable.json"
# APK 构建必须注入实际签名证书 DER 的 SHA-256（小写 64 位），CI 从正式 keystore 推导。
# PUBLIC_ANDROID_SIGNING_CERT_SHA256=""
