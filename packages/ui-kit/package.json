{
	"name": "@chronos/ui-kit",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/index.ts",
	"module": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./src/*",
			"default": "./src/*"
		},
		"./theme/plugin-tailwind.css": "./src/theme/plugin-tailwind.css",
		"./theme/radius.css": "./src/theme/radius.css",
		"./theme/theme-inline.generated.css": "./src/theme/theme-inline.generated.css",
		"./timetable-preview/day-labels": {
			"types": "./src/timetable-preview/day-labels.ts",
			"import": "./src/timetable-preview/day-labels.ts",
			"default": "./src/timetable-preview/day-labels.ts"
		}
	},
	"dependencies": {
		"@chronos/core": "workspace:*",
		"@internationalized/date": "^3.12.4",
		"bits-ui": "^2.19.0"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	}
}
